TELEGRAM_BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
OWNER_TELEGRAM_USER_ID=<YOUR_TELEGRAM_USER_ID>

# Defaults
DEFAULT_TIMEZONE=UTC+8
DEFAULT_CRON_EXPR=0 9 * * *
DEFAULT_MODEL=gpt-5.6-luna
DEFAULT_REASONING_EFFORT=default
SQLITE_PATH=/app/data/bot.db
MAX_MESSAGES_PER_SUMMARY=300
MIN_MESSAGES_TO_SUMMARY=8
MAX_SUMMARY_GAP_HOURS=24
PREVIEW_WINDOW_HOURS=24
OPENAI_MAX_OUTPUT_TOKENS=1800
